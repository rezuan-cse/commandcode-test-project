# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Demo database
*.db
*.sqlite
*.sqlite3

# Database backups. These contain the client's real books and must never be
# committed — keep them off the machine that hosts the database.
backups/
*.dump

# Node
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo

# Environment. `.env.production` holds the database password and the session
# signing key, so it is ignored by pattern rather than by name — a new
# `.env.staging` should not have to be remembered. The example beside it is kept.
.env
.env.*
!.env.example
!**/.env.production.example
.env.local
