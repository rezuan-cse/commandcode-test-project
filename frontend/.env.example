# Frontend build settings. Copy to .env.local for local development.

# Leave blank when the API is on the same origin (the normal local setup, where
# the backend serves the built frontend or Vite proxies /api).
#
# Set this when the interface is hosted separately from the API — for example
# interface on Vercel or Netlify and the API on Render. Include the /api suffix.
#
# VITE_API_BASE=https://rpci-demo.onrender.com/api
