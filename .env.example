# Copy to .env and adjust as needed. Every value is read by app/core/config.py.

# Where the books live.
#
# SQLite (default) — one file, no setup. Lost if the container is rebuilt, which
# is fine locally and for a demo held in a single sitting.
RPCI_DATABASE_URL=sqlite:///./rpci_demo.db
#
# Postgres — use this to keep data across restarts, so nothing a client enters
# disappears when the host sleeps. Paste a hosted URL as-is; the application
# routes postgres:// and postgresql:// to the installed psycopg driver, so no
# +psycopg suffix is needed.
# RPCI_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Seed the database from the workbook on first boot. Idempotent: it does nothing
# once accounts already exist.
RPCI_AUTO_SEED=true
RPCI_SEED_FROM_EXCEL_PATH=../RPCI Accounts.xlsx

# Shared password gate for the demo.
RPCI_DEMO_PASSWORD=rpci

# Comma-separated origins allowed to call the API. "*" is fine for a public demo
# because no cookies are used.
RPCI_CORS_ORIGINS=*

# Allow visitors to restore the demo to the workbook state from the Dashboard.
RPCI_ALLOW_DEMO_RESET=true
