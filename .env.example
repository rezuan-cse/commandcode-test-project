# Copy to .env and adjust as needed. Every value is read by app/core/config.py.

# Where the books live.
#
# SQLite (default) — one file, no setup. Lost if the container is rebuilt, which
# is fine locally and for a demo held in a single sitting.
RPCI_DATABASE_URL=sqlite:///./rpci_demo.db
#
# Postgres — use this to keep data across restarts, so nothing a client enters
# disappears when the host sleeps. Paste a hosted URL as-is; the application
# routes postgres:// and postgresql:// to the installed psycopg driver, so no
# +psycopg suffix is needed.
# RPCI_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Session signing key. Leave it blank and a random one is generated per process:
# that works locally, but everyone is signed out whenever the service restarts.
# Set it on any real deployment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RPCI_JWT_SECRET=

# How long a signed-in session lasts, in minutes. Default 12 hours.
RPCI_ACCESS_TOKEN_MINUTES=720

# Timestamps are stored in UTC and shown at this offset from it. Bangladesh is a
# fixed +06:00 with no daylight saving, so an offset is exact here.
RPCI_UTC_OFFSET_HOURS=6

# What a brand-new, empty database starts with:
#   fresh    - a standard starter chart of accounts, zero balances (default)
#   workbook - the client's sample workbook (RPCI Accounts.xlsx)
#   none     - nothing; the books stay empty until data is entered or imported
# Once the database has data this is not consulted again. Import a workbook or
# start over at any time from Administration → Data.
RPCI_SEED_MODE=fresh
RPCI_SEED_FROM_EXCEL_PATH=../RPCI Accounts.xlsx

# Password given to each seeded demo account (admin@rpci.demo and the rest).
RPCI_DEMO_PASSWORD=rpci

# Create one account per role at startup, each with the password above, so the
# system can be opened and each role tried without any setup. Turn this OFF on a
# deployment holding the client's real books; the accounts then stop being
# created, and the first real administrator is made with:
#
#   backend/.venv/bin/python scripts/create_user.py \
#       --email admin@resinovabd.com --name "Full Name" --role admin
#
# Accounts that already exist are never touched, and never deleted, by this
# setting — including by a data reset. Turn it off, then delete the demo accounts
# from Roles & Access once your own administrators exist.
RPCI_SEED_DEMO_USERS=true

# Sign-in throttling. A wrong password counts against the account; at this many
# the account locks for the given number of minutes, and even the right password
# is refused until the lock passes. A successful sign-in clears the count.
RPCI_LOGIN_MAX_ATTEMPTS=5
RPCI_LOGIN_LOCKOUT_MINUTES=15

# Comma-separated origins allowed to call the API. "*" is fine for a public demo
# because no cookies are used.
RPCI_CORS_ORIGINS=*

# Allow an administrator to start the books over from Administration → Data.
# Set false on a deployment whose data must never be lost. Either way the user
# accounts are kept, so a reset can never lock anybody out.
RPCI_ALLOW_DATA_RESET=true
