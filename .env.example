# Copy to .env and adjust as needed. Every value is read by app/core/config.py.

# SQLite location. Use an absolute path with four slashes.
RPCI_DATABASE_URL=sqlite:///./rpci_demo.db

# Seed the database from the workbook on first boot.
RPCI_AUTO_SEED=true
RPCI_SEED_FROM_EXCEL_PATH=../RPCI Accounts.xlsx

# Shared password gate for the demo.
RPCI_DEMO_PASSWORD=rpci
