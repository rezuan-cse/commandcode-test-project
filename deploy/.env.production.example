# Copy to .env.production on the server and fill in the blanks.
#
#     cp deploy/.env.production.example .env.production
#     chmod 600 .env.production          # it holds the database password
#
# Nothing in this file belongs in git. `.env*` is ignored, apart from the example.

# The address Caddy serves. A real domain gets a public certificate automatically;
# an internal name gets Caddy's local CA instead.
SITE_ADDRESS=rpci.example.com

# Database credentials. The application connects as this user to the `db` service
# over the compose network, never over the internet.
POSTGRES_DB=rpci
POSTGRES_USER=rpci
# Generate one:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Signs the session token. Changing it signs everybody out. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RPCI_JWT_SECRET=
