# Caddy configuration.
#
# The public face is a Cloudflare Tunnel, so Caddy is not a public TLS server:
# Cloudflare serves the public certificate, and the tunnel terminates TLS at
# the edge. Caddy listens only on plain HTTP, and only on the compose network.
#
# One site block is enough. It matches the public hostname the tunnel forwards
# by, and it answers on port 80 only. No ACME challenge ever happens here, so
# no port 80/443 need be open on this box.
#
# SITE_ADDRESS is the public hostname the tunnel forwards for:
#   erp.company.example.com     a real domain  → Cloudflare serves TLS on it
#   :80                         no TLS at all — only sensible behind a tunnel
# The :80 suffix is explicit: without it, Caddy would treat a bare hostname as
# an HTTPS site, try to obtain a public certificate itself, and force a
# redirect on port 80 — which, served by Cloudflare, is what produces the
# "page isn't redirecting properly" loop. Cloudflare terminates TLS at the
# edge, so nothing here needs a certificate.

{$SITE_ADDRESS}:80 {
	# The application. Everything goes to it: the API under /api, the SPA and its
	# assets everywhere else, because FastAPI serves the built frontend itself.
	reverse_proxy app:8000

	# Uploads: the workbook import is the only large request. A generous ceiling
	# avoids a confusing 413 if the client's real workbook is bigger than the
	# sample one.
	request_body {
		max_size 64MB
	}

	# Financial data and payroll behind a login should not be cached by anything
	# between the browser and this box.
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	log {
		output stderr
		format console
	}
}
